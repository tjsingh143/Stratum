
> source("r/common.R")

> d <- read.csv(file.path(DERIVED, "oxide.csv"))

> stopifnot(nrow(d) == 72)

> d$Source <- factor(d$Source)

> d$Lot <- factor(d$Lot)

> d$Wafer <- factor(d$Wafer)

> a <- nlevels(d$Lot)

> b <- 3

> n <- 3

> fit_aov <- aov(Thickness ~ 1 + Error(Lot/Wafer), data = d)

> summary(fit_aov)

Error: Lot
          Df Sum Sq Mean Sq F value Pr(>F)
Residuals  7   9025    1289               

Error: Lot:Wafer
          Df Sum Sq Mean Sq F value Pr(>F)
Residuals 16   1923   120.2               

Error: Within
          Df Sum Sq Mean Sq F value Pr(>F)
Residuals 48  603.3   12.57               

> strata <- aov_strata(fit_aov)

> ms <- setNames(strata$ms, c("lot", "wafer", "site"))

> mom <- c(lot = unname(ms["lot"] - ms["wafer"])/(b * 
+     n), wafer = unname(ms["wafer"] - ms["site"])/n, site = unname(ms["site"]))

> mom
      lot     wafer      site 
129.90719  35.86574  12.56944 

> fit_lmer <- lmer(Thickness ~ 1 + (1 | Lot/Wafer), 
+     data = d, REML = TRUE)

> summary(fit_lmer)
Linear mixed model fit by REML. t-tests use Satterthwaite's method ['lmerModLmerTest']
Formula: Thickness ~ 1 + (1 | Lot/Wafer)
   Data: d

REML criterion at convergence: 454

Scaled residuals: 
    Min      1Q  Median      3Q     Max 
-1.8746 -0.4991  0.1047  0.5510  1.7922 

Random effects:
 Groups    Name        Variance Std.Dev.
 Wafer:Lot (Intercept)  35.87    5.989  
 Lot       (Intercept) 129.91   11.398  
 Residual               12.57    3.545  
Number of obs: 72, groups:  Wafer:Lot, 24; Lot, 8

Fixed effects:
            Estimate Std. Error       df t value Pr(>|t|)    
(Intercept) 2000.153      4.232    7.000   472.6   <2e-16 ***
---
Signif. codes:  0 ‘***’ 0.001 ‘**’ 0.01 ‘*’ 0.05 ‘.’ 0.1 ‘ ’ 1

> ci <- profile_sd_ci(fit_lmer)

> ci
                 parameter    lower     upper
1 sd_(Intercept)|Wafer:Lot 4.147668  9.136751
2       sd_(Intercept)|Lot 6.264282 19.760984
3                    sigma 2.939065  4.392722

> fit_lme <- nlme::lme(Thickness ~ 1, random = ~1 | 
+     Lot/Wafer, data = d, method = "REML")

> fit_lme
