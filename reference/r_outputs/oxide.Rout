> an_sat <- lmertest_anova(fit_lmer_src, "Satterthwaite")

> an_kr <- lmertest_anova(fit_lmer_src, "Kenward-Roger")

> an_sat
    term num_df   den_df        F         p
1 Source      1 5.999996 1.526122 0.2628701

> an_kr
    term num_df den_df        F         p
1 Source      1      6 1.526122 0.2628701

> op <- options(contrasts = c("contr.SAS", "contr.poly"))

> fit_lme_src <- nlme::lme(Thickness ~ Source, random = ~1 | 
+     Lot/Wafer, data = d, method = "REML")

> summary(fit_lme_src)
