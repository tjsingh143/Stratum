> lme_src_tt <- summary(fit_lme_src)$tTable

> options(op)

> write_result(list(dataset = "MEMSS Oxide", design = list(a_lots = a, 
+     b_wafers_per_lot = b, n_sites_per_wafer = n, source_levels = nlevels(d$Source), 
+     lots_per_source = 4), without_source = list(aov_error_strata = strata, 
+     mom_variance_components = as.list(mom), mom_sd = as.list(sqrt(mom)), 
+     lmer_reml = list(vc = lmer_vc(fit_lmer), intercept = unname(fixef(fit_lmer)), 
+         singular = isSingular(fit_lmer), profile_sd_ci = ci), 
+     nlme_reml = list(vc = nlme_vc(fit_lme), intercept = unname(nlme::fixef(fit_lme)), 
+         logLik = as.numeric(logLik(fit_lme)), sd_intervals = list(Lot = as.list(lme_int$reStruct$Lot[1, 
+             ]), Wafer = as.list(lme_int$reStruct$Wafer[1, ]), 
+             residual = as.list(lme_int$sigma)))), with_source_fixed = list(aov_error_strata = aov_strata(fit_aov_src), 
+     lmer_reml = list(vc = lmer_vc(fit_lmer_src), fixef = as.list(fixef(fit_lmer_src)), 
+         singular = isSingular(fit_lmer_src)), lmertest_type3_satterthwaite = an_sat, 
+     lmertest_type3_kenward_roger = an_kr, nlme_reml_contr_sas = list(vc = nlme_vc(fit_lme_src), 
+         ttable = data.frame(term = rownames(lme_src_tt), lme_src_tt, 
+             row.names = NULL, check.names = TRUE)))), "oxide.json")
