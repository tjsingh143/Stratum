
> source("r/common.R")

> d <- read.csv(file.path(DERIVED, "semiconductor.csv"))

> stopifnot(nrow(d) == 48)

> d$ET <- factor(d$ET)

> d$position <- factor(d$position)

> d$Grp <- factor(d$Grp)

> fit_split <- aov(resistance ~ ET * position + Error(Grp), 
+     data = d)

> summary(fit_split)

