> options(op)

> write_result(list(dataset = "SASmixed Semiconductor", 
+     design = list(a_et_levels = nlevels(d$ET), r_wafers_per_et = 3, 
+         b_positions = nlevels(d$position)), split_plot_aov_error_strata = aov_strata(fit_split), 
+     naive_aov = aov_table(fit_naive), lmer_reml = list(vc = lmer_vc(fit_lmer), 
+         singular = isSingular(fit_lmer), reml_criterion = unname(REMLcrit(fit_lmer))), 
+     lmertest_type3_satterthwaite = an_sat, lmertest_type3_kenward_roger = an_kr, 
+     nlme_ml_contr_sas = list(vc = nlme_vc(fit_lme_ml), logLik = as.numeric(logLik(fit_lme_ml)), 
+         AIC = AIC(fit_lme_ml), BIC = BIC(fit_lme_ml))), "semiconductor.json")
